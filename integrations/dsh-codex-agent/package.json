{
  "name": "@myterm/dsh-codex-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "In-process trimmed Codex Core provider for DeepSeek Harness",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "native-dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:native": "napi build --platform --release --manifest-path native/Cargo.toml --output-dir native-dist",
    "clean:ts": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:ts": "npm run clean:ts && tsc -p tsconfig.json",
    "build": "npm run build:native && npm run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test:native": "cargo test --manifest-path native/Cargo.toml",
    "test:ts": "vitest run",
    "test": "npm run test:native && npm run test:ts",
    "lint": "biome check src tests"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@modelcontextprotocol/sdk": "1.29.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@napi-rs/cli": "3.8.6",
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "zod": "4.4.3"
  }
}
